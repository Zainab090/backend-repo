# =========================================================================
# LUCKY PETROLEUM BACKEND SERVER - ENVIRONMENT VARIABLES TEMPLATE
# Rename this file to '.env' inside your server directory.
# NEVER share the actual filled file on GitHub or public drives.
# =========================================================================

# 1. Server Configuration
PORT=5000

# 2. Database Connection (MongoDB Cloud/Atlas)
MONGO_URI=your_mongodb_atlas_connection_string_here

# 3. AI Chatbot API Configuration (OpenRouter Backend Pipeline)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Central Admin Dashboard Credentials
ADMIN_SECRET_KEY=your_secure_random_jwt_or_session_secret_here
ADMIN_USERNAME=lucky_admin
ADMIN_EMAIL=admin@luckypetroleum.com